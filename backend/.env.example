# ====== GROQ AI CONFIGURATION ======

# Primary Groq API key (used for interviews, resume analysis, teach-me, aptitude)
GROQ_API_KEY_PRIMARY=your_groq_api_key_primary_here

# Secondary Groq API key (used for GD bots - lightweight fast responses)
GROQ_API_KEY_GD_BOTS=your_groq_api_key_gd_bots_here

# Groq models (defaults shown — only change if you want to override)
# GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
# GROQ_MODEL_GD=llama-3.1-8b-instant

# ====== GOOGLE DOCUMENT AI (Optional - for PDF OCR in Resume Analyzer) ======
# If not configured, the backend will fall back to local pdfplumber/PyPDF2 extraction.
DOCUMENTAI_PROJECT_ID=your_google_cloud_project_id
DOCUMENTAI_LOCATION=us
DOCUMENTAI_PROCESSOR_ID=your_processor_id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# ====== JUDGE0 CODE EXECUTION (for Coding Module) ======
# The backend tries EC2 first, falls back to localhost if unreachable.
# Primary: AWS EC2 instance running Judge0 via Docker
JUDGE0_EC2_URL=http://your_ec2_public_dns:2358
# Fallback: Local Docker instance (start with: docker run -d -p 2358:2358 judge0/judge0-ce)
JUDGE0_LOCAL_URL=http://localhost:2358
# Optional: Override both and force a specific URL
# JUDGE0_URL=http://your_ec2_public_dns:2358

# ====== FIREBASE CONFIGURATION ======
# Firebase service account credentials are loaded from firebase-service-account.json
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# For production (Render): paste the entire JSON content as a single-line env var:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
